# Publish only project code, documentation and aggregate outputs.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CITATION.cff
!/index.html
!/.nojekyll
!/requirements.txt
!/requirements-lock.txt
!/scripts/
!/docs/
!/data/
!/output/

/scripts/*
!/scripts/*.py
/docs/*
!/docs/*.csv
!/docs/visual_review.json
!/docs/question_trends_visual_review.json
/data/*
!/data/source_manifests/
/data/source_manifests/*
!/data/source_manifests/*.json
/output/*
!/output/*.md
!/output/tables/
!/output/figures/
!/output/question_trends/
!/output/pdf/
/output/pdf/*
!/output/pdf/ukraine_market_attitudes.pdf

# Additional protection for respondent files, credentials and generated caches.
**/__pycache__/
*.pyc
*.sav
*.zsav
*.dta
*.zip
.env
.env.*
*.pem
*.key
